APP_ENV=development
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nextbuy

# Pagamento atual: PIX gerado por pedido e confirmado manualmente pela equipe.
# Não publique sua chave PIX real no GitHub. Preencha somente no .env local/ambiente privado.
PIX_KEY=
PIX_RECEIVER_NAME=

# IA da loja. As chaves são opcionais: o bot usa somente os provedores com chave configurada.
# Os modelos gratuitos/padrão abaixo já funcionam sem você precisar preencher o campo MODEL.
# Nunca publique chaves reais no GitHub.
AI_PROVIDER_ORDER=groq,gemini,openrouter,openai,anthropic,xai,mistral
AI_TIMEOUT_SECONDS=18
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
XAI_API_KEY=
XAI_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Integrações antigas opcionais: necessárias apenas se ainda houver pagamentos legados em processamento.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREDITS_PRODUCT_ID=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

PUBLIC_BASE_URL=http://localhost:8000
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
